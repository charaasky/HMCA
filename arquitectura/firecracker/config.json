{
  "boot-source": {
    "kernel_image_path": "/var/lib/hcma-firecracker/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/hcma-firecracker/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true
    }
  ],
  "network-interfaces": [],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 512,
    "smt": false
  }
}
